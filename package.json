{
  "name": "infinitysqlite",
  "version": "1.3.10",
  "description": "Native SQLite3 binding for Node.js, own implementation in C++ with N-API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "gypfile": true,
  "files": [
    "binding.gyp",
    "src/**/*.cpp",
    "src/**/*.h",
    "src/**/*.hpp",
    "deps/sqlite3/**",
    "dist/**",
    "prebuilds/**"
  ],
  "scripts": {
    "build:native": "node-gyp rebuild",
    "build:ts": "tsc -p .",
    "build": "npm run build:native && npm run build:ts",
    "prebuild": "prebuildify --napi --strip -t 20.0.0",
    "install": "node dist/install.js",
    "prepack": "npm run build:ts",
    "checkprebuilds": "node scripts/check-prebuilds.js",
    "prepublishOnly": "npm run build:ts && npm run checkprebuilds"
  },
  "dependencies": {
    "node-addon-api": "^8.0.0",
    "node-gyp": "^10.0.0"
  },
  "devDependencies": {
    "prebuildify": "^6.0.1",
    "typescript": "^5.5.0",
    "@types/node": "^20.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "license": "Apache-2.0 license",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Neykoor/InfinitySQLite.git"
  }
}
