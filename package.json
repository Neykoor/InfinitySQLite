{
  "name": "InfinitySQLite",
  "version": "1.0.0",
  "description": "Native SQLite3 binding for Node.js, own implementation in C++ with N-API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "gypfile": true,
  "scripts": {
    "build:native": "node-gyp rebuild",
    "build:ts": "tsc -p .",
    "build": "npm run build:native && npm run build:ts",
    "install": "node-gyp rebuild"
  },
  "dependencies": {
    "node-addon-api": "^8.0.0"
  },
  "devDependencies": {
    "node-gyp": "^10.0.0",
    "typescript": "^5.5.0",
    "@types/node": "^20.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "license": "MIT"
}
